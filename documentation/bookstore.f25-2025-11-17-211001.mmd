classDiagram

    Product <|-- Ticket
    Product <|-- Publication
    Publication <|-- Book
    Publication <|-- Magazine
    Magazine <|-- DiscMag

    SaleableItem <|.. Product
    Serializable <|.. Product

    Cart "*" -- "*" Product : contains
    Order "*" -- "*" Product : contains

    class Product {
        <<abstract>>
        -Long id
        -Set~Cart~ carts
        -Set~Order~ orders
        +Long getId()
        +void setId(Long id)
        +Set~Cart~ getCarts()
        +void setCarts(Set~Cart~ carts)
        +Set~Order~ getOrders()
        +void setOrders(Set~Order~ orders)
    }

    class Cart {
        -Long id
        -Set~Product~ products
        +Long getId()
        +void setId(Long id)
        +Set~Product~ getProducts()
        +void setProducts(Set~Product~ products)
        +void addProduct(Product product)
    }

    class Order {
        -Long id
        -double totalAmount
        -LocalDateTime orderDate
        -Set~Product~ products
        +Long getId()
        +void setId(Long id)
        +double getTotalAmount()
        +void setTotalAmount(double totalAmount)
        +LocalDateTime getOrderDate()
        +void setOrderDate(LocalDateTime orderDate)
        +Set~Product~ getProducts()
        +void setProducts(Set~Product~ products)
        +void addProduct(Product product)
    }

    class Publication {
        <<abstract>>
        -String title
        -double price
        -int copies
        +String getTitle()
        +void setTitle(String title)
        +double getPrice()
        +void setPrice(double price)
        +int getCopies()
        +void setCopies(int copies)
        +void sellItem()
    }

    class Book {
        -String isbn
        -String author
        +String getIsbn()
        +String getAuthor()
        +void sellItem()
    }

    class Magazine {
        -int orderQty
        -LocalDateTime currentIssue
        +int getOrderQty()
        +LocalDateTime getCurrentIssue()
    }

    class DiscMag {
        -boolean hasDisc
        +boolean isHasDisc()
    }

    class Ticket {
        -String description
        -double price
        +String getDescription()
        +double getPrice()
        +void sellItem()
    }

    class SaleableItem {
        <<interface>>
        +void sellItem()
        +double getPrice()
    }

    class Serializable {
        <<interface>>
    }