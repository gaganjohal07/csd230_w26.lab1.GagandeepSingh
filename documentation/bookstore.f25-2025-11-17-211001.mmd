classDiagram

    Product <|-- Ticket
    Product <|-- Publication
    Publication <|-- Book
    Publication <|-- Magazine
    Magazine <|-- DiscMag

    SaleableItem <|.. Product
    Serializable <|.. Product

    Cart "*" -- "*" Product : contains

    class Product {
        <<abstract>>
        -Long id
        -Set~Cart~ carts
        +Long getId()
        +Set~Cart~ getCarts()
    }

    class Cart {
        -Long id
        -Set~Product~ products
        +Long getId()
        +Set~Product~ getProducts()
        +addProduct(Product product)
    }

    class Publication {
        <<abstract>>
        -String title
        -double price
        -int copies
        +String getTitle()
        +double getPrice()
        +int getCopies()
        +sellItem()
    }

    class Book {
        -String isbn
        -String author
        +String getIsbn()
        +String getAuthor()
        +sellItem()
    }

    class Magazine {
        -int orderQty
        -LocalDateTime currentIssue
        +int getOrderQty()
        +LocalDateTime getCurrentIssue()
    }

    class DiscMag {
        -boolean hasDisc
        +boolean isHasDisc()
    }

    class Ticket {
        -String description
        -double price
        +String getDescription()
        +double getPrice()
        +sellItem()
    }

    class SaleableItem {
        <<interface>>
        +sellItem()
        +double getPrice()
    }

    class Serializable {
        <<interface>>
    }